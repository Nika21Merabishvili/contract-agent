# Environment configuration for nxia-contract-agent (network-reachable deploy).
# Copy to `.env`, fill in NXIA_SECRET_KEY, and load it into the server's
# environment before starting (`serve.py`). NEVER commit the real .env.
# See SECURITY.md for the full deployment guide.

# --- required in production ---
# Signs the session cookie. Must be secret, >= 32 chars, and stable across
# restarts (a new value logs everyone out). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NXIA_SECRET_KEY=

# production (default) enables secure cookies + HSTS and REQUIRES the secret
# above. Set to "development" only for local testing over plain http.
NXIA_ENV=production

# --- reverse proxy / transport ---
# Number of trusted proxy hops in front of the app (nginx terminating TLS = 1).
NXIA_TRUSTED_PROXY_HOPS=1
# Secure cookie flag. Keep 1 in production (TLS). Set 0 ONLY for local http dev.
NXIA_COOKIE_SECURE=1
# HTTP Strict Transport Security (served once TLS is in front).
NXIA_HSTS=1
NXIA_HSTS_MAX_AGE=31536000

# --- where things live ---
# Local login store (bcrypt hashes). Keep outside the repo / web root.
NXIA_USERS_FILE=instance/users.json
# Audit log directory (not web-accessible).
NXIA_LOG_DIR=logs

# --- sessions ---
NXIA_SESSION_LIFETIME_MIN=480

# --- upload limits (denial-of-service guards) ---
NXIA_MAX_FILES=20
NXIA_MAX_PDF_BYTES=26214400
NXIA_MAX_TOTAL_BYTES=209715200
NXIA_MAX_PAGES=100
NXIA_PDF_PARSE_TIMEOUT_S=20
NXIA_ANALYSIS_TIMEOUT_S=600

# --- login throttling / lockout ---
NXIA_MAX_LOGIN_FAILURES=5
NXIA_LOGIN_WINDOW_S=900
NXIA_LOCKOUT_SECONDS=900

# --- local login password policy ---
NXIA_MIN_PASSWORD_LENGTH=12
NXIA_BCRYPT_ROUNDS=12

# --- serve.py (waitress) ---
NXIA_HOST=127.0.0.1
NXIA_PORT=8000
NXIA_THREADS=8
